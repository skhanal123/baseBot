{
  "name": "basebot",
  "private": true,
  "type": "module",
  "description": "Embeddable AI chat framework monorepo",
  "packageManager": "pnpm@9.15.9",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "test": "pnpm -r run test && node --test scripts/lib/demo-setup-plan.test.mjs scripts/lib/soak-uptime.test.mjs",
    "soak:monitor": "node scripts/soak-monitor.mjs",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "generate:openapi": "pnpm --filter @basebot/core run generate:openapi",
    "migrate": "pnpm --filter @basebot/node run migrate",
    "seed:demo": "node scripts/seed-demo-data.mjs",
    "demo:setup": "node scripts/demo-setup.mjs",
    "demo": "pnpm --filter @basebot/example-node-demo run start",
    "demo:widget": "pnpm --filter @basebot/example-react-demo run dev"
  },
  "devDependencies": {
    "@eslint/js": "^9.22.0",
    "@types/node": "^22.13.10",
    "eslint": "^9.22.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.1",
    "vitest": "^3.0.8"
  }
}
