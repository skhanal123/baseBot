# Copy to .env for local development
# Durable store: postgres (recommended default) or mongo — configure exactly one adapter at deploy
DURABLE_STORE=postgres
DATABASE_URL=postgres://basebot:basebot@localhost:5434/basebot
# Used when DURABLE_STORE=mongo
MONGODB_URL=mongodb://localhost:27017/basebot
REDIS_URL=redis://localhost:6379
STREAM_SIGNING_SECRET=change-me-in-production
OPENAI_API_KEY=
# Optional: openai | gemini | claude | deepseek | mock (defaults to openai if OPENAI_API_KEY set, else mock)
LLM_PROVIDER=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
DEEPSEEK_API_KEY=
PORT=3000
