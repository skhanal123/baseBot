# Local demo / integrator environment (not read by @basebot/node).
# Copy to `.env` at repo root and export vars in your shell, or use your host's secret injection.
#
# Canonical list with comments: demos/node-demo/.env.example

DURABLE_STORE=postgres
DATABASE_URL=postgres://basebot:basebot@localhost:5434/basebot
MONGODB_URL=mongodb://localhost:27017/basebot
REDIS_URL=redis://localhost:6379
STREAM_SIGNING_SECRET=change-me-in-production

# Required for telecom demo (embeddings + default chat when LLM_PROVIDER unset)
OPENAI_API_KEY=

# Web search tool (Serper)
SERPER_API_KEY=

# Optional chat provider (framework adapters: openai | gemini | claude | deepseek | mock)
# LLM_PROVIDER=mock
# GEMINI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=
