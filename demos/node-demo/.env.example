# Copy to repo root as `.env` (or export in your shell) before `pnpm demo`.
# Required for demos/node-demo — not read by @basebot/node (pass options to createServer).

DURABLE_STORE=postgres
DATABASE_URL=postgres://basebot:basebot@localhost:5434/basebot
MONGODB_URL=mongodb://localhost:27017/basebot
REDIS_URL=redis://localhost:6379
STREAM_SIGNING_SECRET=change-me-in-production

# Chat LLM (resolveLlmConfigFromEnv): set OPENAI_API_KEY and optional LLM_PROVIDER
OPENAI_API_KEY=
LLM_PROVIDER=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=
# Use LLM_PROVIDER=mock for mock chat without a provider key (OPENAI_API_KEY still required for demo embeddings)

PORT=3000

# Telecom tools
SERPER_API_KEY=
TELECOM_TOOLS_HTTP=
TELECOM_TOOLS_HTTP_BASE=

# Seed CLI (optional)
SEED_DATA_DIR=
